<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>WStart</Name>
    <Version>@VERSION@</Version>
    <Title>WStart Setup</Title>
    <Publisher>WStart</Publisher>
    <ProductUrl>https://github.com/weaver2007/HotKeyManager</ProductUrl>
    <StartMenuDir>WStart</StartMenuDir>
    <TargetDir>@ApplicationsDirX64@/WStart</TargetDir>
    <InstallerApplicationIcon>app</InstallerApplicationIcon>
    <InstallerWindowIcon>app.ico</InstallerWindowIcon>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>760</WizardDefaultWidth>
    <WizardDefaultHeight>500</WizardDefaultHeight>
    <MaintenanceToolName>WStartMaintenance</MaintenanceToolName>
    <RemoveTargetDir>true</RemoveTargetDir>
</Installer>
