#pragma once

#include <QObject>

class QSignalBlocker {
public:
    explicit QSignalBlocker(QObject* object)
        : m_object(object), m_previous(object ? object->blockSignals(true) : false) {}

    ~QSignalBlocker() {
        if (m_object) {
            m_object->blockSignals(m_previous);
        }
    }

private:
    QObject* m_object;
    bool m_previous;
};
